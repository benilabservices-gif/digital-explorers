# Projet Supabase (staging ou production) — valeurs depuis le dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<cle_anon_publique>

# Connexion psql via le pooler (scripts db:seed / import:content) — usage local
# uniquement, ne jamais exposer côté client ni commit
SUPABASE_DB_HOST=aws-0-eu-west-3.pooler.supabase.com
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<mot_de_passe_db>
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres

# Coach IA (OpenRouter ou compatible)
AI_API_KEY=
AI_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=anthropic/claude-3.5-haiku
