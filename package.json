{
  "name": "digital-explorers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types --lang=typescript --linked --schema public > src/lib/supabase/database.types.ts",
    "db:seed": "node scripts/seed.mjs",
    "db:make-admin": "node scripts/make-admin.mjs",
    "import:content": "node scripts/import-content.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "smoke:content": "node scripts/smoke-content.mjs",
    "flow:check": "node scripts/flow-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
